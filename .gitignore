.dart_tool/

# Pacote de biblioteca: o lock não é versionado, para que a resolução seja a do
# consumidor e não a desta máquina.
pubspec.lock

# Árvores de código de referência (Blend2D, Cairo, FreeType, Skia, OpenJDK...)
# baixadas para estudo durante o port. São de terceiros, cada uma sob a sua
# própria licença, e não pertencem a este repositório. Veja NOTICE.
referencias/

tmp/

# Saída de `dart doc`.
doc/api/
build/

# Dumps de inspeção visual gerados pelos benchmarks.
*.ppm
output/

# Material de terceiros baixado para estudo: a especificacao SVG 2 do W3C em
# HTML com seus arquivos, o MathJax e posts de blog. Nao e copyleft e nao
# alcanca a licenca do pacote, mas redistribuir o texto integral de artigo com
# copyright num repositorio publico e redistribuicao sem autorizacao, e a
# unica vantagem sobre um link e ler offline. As notas de projeto proprias,
# em pesquisa/*.md, continuam versionadas.
pesquisa/news/
